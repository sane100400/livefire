# 행사 당일 이 파일을 .env 로 복사 후 실제 값으로 교체
# cp .env.example .env && vim .env

# ── 필수 시크릿 (없으면 서버 시작 시 KeyError 크래시) ─────────────────
ADMIN_SECRET=replace_before_event
TOKEN_TEAM_A=replace_before_event
TOKEN_TEAM_B=replace_before_event
TOKEN_TEAM_C=replace_before_event
TOKEN_TEAM_D=replace_before_event
TOKEN_TEAM_E=replace_before_event
TOKEN_TEAM_F=replace_before_event

# ── 디펜스 에이전트 전용 토큰 (오프라인 참가자에게만 배포) ───────────
# 미설정 시 로컬 개발 편의를 위해 TOKEN_TEAM_X로 fallback
# DEFENSE_TOKEN_TEAM_A=replace_before_event
# DEFENSE_TOKEN_TEAM_B=replace_before_event
# DEFENSE_TOKEN_TEAM_C=replace_before_event
# DEFENSE_TOKEN_TEAM_D=replace_before_event
# DEFENSE_TOKEN_TEAM_E=replace_before_event
# DEFENSE_TOKEN_TEAM_F=replace_before_event

# ── 팀 서비스 IP (기본값: 192.168.0.10-15) ───────────────────────────
# IP_TEAM_A=192.168.0.10
# IP_TEAM_B=192.168.0.11
# IP_TEAM_C=192.168.0.12
# IP_TEAM_D=192.168.0.13
# IP_TEAM_E=192.168.0.14
# IP_TEAM_F=192.168.0.15

# ── 경로 (기본값 사용 시 주석 처리 유지) ─────────────────────────────
# VULN_SPEC_DIR=/app/vuln_specs
# DB_PATH=/app/game_state.db
# COORDINATOR_URL=http://localhost:9000

# ── OpenRouter gateway (coordinator만 보유) ──────────────────────────
OPENROUTER_API_KEY=replace_before_event
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── PoC 저장/실행 ───────────────────────────────────────────────────
# DATA_DIR=/app/data
# POC_TIMEOUT_SEC=20
# POC_MAX_BYTES=65536
# POC_OUTPUT_MAX_BYTES=65536

# ── Legacy 즉시 flag 제출 채점 ─────────────────────────────────────
# 기본값 0: /submit-flag 비활성화, /pocs 재실행 채점 사용
ENABLE_LEGACY_SUBMIT_FLAG=0
