# 행사 당일 이 파일을 .env 로 복사 후 실제 값으로 교체
# cp .env.example .env && vim .env

# ── 필수 시크릿 (없으면 서버 시작 시 KeyError 크래시) ─────────────────
ADMIN_SECRET=replace_before_event
RUNNER_SECRET=replace_before_event
CHECKER_TOKEN=replace_before_event
TOKEN_TEAM_1=replace_before_event
TOKEN_TEAM_2=replace_before_event
TOKEN_TEAM_3=replace_before_event
TOKEN_TEAM_4=replace_before_event
TOKEN_TEAM_5=replace_before_event
TOKEN_TEAM_6=replace_before_event

# ── 디펜스 에이전트 전용 토큰 (오프라인 참가자에게만 배포) ───────────
# 운영에서는 반드시 팀 토큰과 다른 값으로 설정
# DEFENSE_TOKEN_TEAM_1=replace_before_event
# DEFENSE_TOKEN_TEAM_2=replace_before_event
# DEFENSE_TOKEN_TEAM_3=replace_before_event
# DEFENSE_TOKEN_TEAM_4=replace_before_event
# DEFENSE_TOKEN_TEAM_5=replace_before_event
# DEFENSE_TOKEN_TEAM_6=replace_before_event

# ── 공개 포트 할당 (knights.hspace.io 기준) ───────────────────────────
# MANAGEMENT_HOST_PORT=42000
# PUBLIC_COORDINATOR_URL=http://knights.hspace.io:42000
#
# 팀 지급용 외부 포트:
# team1=42001, team2=42002, team3=42003, team4=42004, team5=42005, team6=42006

# ── 팀 서비스 IP/포트 (기본값: team1~6 = 10.89.21.10-15:8000) ─────
# TEAM_SUFFIXES=1,2,3,4,5,6
# IP_TEAM_1=10.89.21.10
# IP_TEAM_2=10.89.21.11
# IP_TEAM_3=10.89.21.12
# IP_TEAM_4=10.89.21.13
# IP_TEAM_5=10.89.21.14
# IP_TEAM_6=10.89.21.15
# PORT_TEAM_1=8000
# PORT_TEAM_2=8000
# PORT_TEAM_3=8000
# PORT_TEAM_4=8000
# PORT_TEAM_5=8000
# PORT_TEAM_6=8000
# HOST_PORT_TEAM_1=42001
# HOST_PORT_TEAM_2=42002
# HOST_PORT_TEAM_3=42003
# HOST_PORT_TEAM_4=42004
# HOST_PORT_TEAM_5=42005
# HOST_PORT_TEAM_6=42006

# ── 경로 (기본값 사용 시 주석 처리 유지) ─────────────────────────────
# VULN_SPEC_DIR=/app/vuln_specs
# REPOS_DIR=/app/repos
# DB_PATH=/app/data/game_state.db
# COORDINATOR_URL=http://localhost:42000
# HOOK_COORDINATOR_URL=http://127.0.0.1:9000

# ── OpenRouter gateway (coordinator만 보유) ──────────────────────────
OPENROUTER_API_KEY=replace_before_event
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── PoC 저장/실행 ───────────────────────────────────────────────────
# DATA_DIR=/app/data
# POC_TIMEOUT_SEC=20
# Blind SQLi처럼 PoC가 여러 target request를 보내야 하면 45~60초 정도로 올린다.
# POC_TIMEOUT_SEC=60
# POC_MAX_BYTES=65536
# POC_OUTPUT_MAX_BYTES=65536
# POC_RUNNER_MODE=auto
# POC_DOCKER_NETWORK=hackathon_target-net
# POC_DOCKER_IMAGE=python:3.11-slim
# Docker socket 모드에서 host daemon이 마운트할 DATA_DIR 절대경로.
# docker-compose.yml은 기본값으로 ${PWD}/data를 넘긴다.
# POC_HOST_DATA_DIR=/absolute/path/to/hackathon/data

# ── 보안 기본값 ─────────────────────────────────────────────────────
# 운영에서는 아래 unsafe 옵션을 켜지 않는다.
# ALLOW_UNSAFE_AGENT_RUNS=0
# ALLOW_STUDENT_AGENT_RUNS=0
# MAX_LLM_MESSAGES=32
# MAX_LLM_PROMPT_BYTES=131072
# MAX_LLM_MAX_TOKENS=4096
# MAX_ATTACK_REQUEST_BYTES=65536
# MAX_ATTACK_RESPONSE_BYTES=131072
# /agent/attack 탐색 요청의 라운드당 예산. Blind SQLi 탐색까지 허용하려면 별도로 올린다.
# MAX_ATTACKS_ROUND=10

# ── 요청 빈도 제한 (6팀 동시 agent 운영 기준 기본값) ───────────────
# agent run token > bearer token > team token > admin secret > client IP 순으로 적용
# attack/defense agent run 생성 제한. /agent/attack 탐색 요청 제한이 아니다.
# RATE_LIMIT_ATTACK_AGENT_RUNS=10/minute
# RATE_LIMIT_DEFENSE_AGENT_RUNS=5/minute
# RATE_LIMIT_REPO_ARCHIVE=6/minute
# RATE_LIMIT_LLM=30/minute
# RATE_LIMIT_ATTACK=20/minute
# RATE_LIMIT_POC_SUBMIT=12/minute
# RATE_LIMIT_TOOLS=60/minute
